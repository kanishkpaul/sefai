{
  "name": "Reject attribution",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Human-authored commits",
        "negate": true,
        "operator": "regex",
        "pattern": "(?i)(co[\\s-]*authored[\\s-]*by\\s*:|(generated|written|created|authored|assisted|powered)\\s+(with|by)\\s+[^\\n]*(claude|anthropic|openai|chatgpt|gpt[- ]|codex|copilot|cursor|gemini|devin|aider|windsurf|codeium|cline|tabnine|\\bai\\b|coding agent|assistant)|noreply@anthropic\\.com)"
      }
    }
  ]
}
